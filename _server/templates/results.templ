package templates

import (
	"fmt"
	"strings"

	"github.com/rubiojr/gasdb/_server/internal/search"
	"github.com/rubiojr/gasdb/_server/translations"
	"github.com/rubiojr/gasdb/pkg/api"
)

templ ResultsPage(stations []api.StationWithDistance, query, resolvedLocation string, lat, lng, radius float64, err error, suggestions []search.RadiusSuggestion, t translations.Translations) {
	@Base(t.ResultsTitle, t) {
		<div class="results">
			<div class="results-header">
				<h1>{ t.NearbyStations }</h1>
				if query != "" {
					<p class="results-location"><span class="text-muted">{ t.ResultsFor }</span><strong>{ query }</strong></p>
					if resolvedLocation != "" {
						<p class="results-location resolved-location"><span class="text-muted">{ t.ResolvedLocation }</span><strong>{ resolvedLocation }</strong></p>
					}
				} else {
					<p class="results-location"><span class="text-muted">{ t.ResultsForCoords }</span><strong>{ fmt.Sprintf("%.6f, %.6f", lat, lng) }</strong></p>
				}
				<div class="results-toolbar">
					<p class="results-radius"><span class="text-muted">{ t.RadiusLabel }</span><strong>{ fmt.Sprintf("%.1f km", radius) }</strong></p>
					<a href={ templ.SafeURL("/?lang=" + t.Language) } class="btn btn-outline-dark">{ t.NewSearchButton }</a>
				</div>
			</div>
			if len(stations) == 0 && err == nil {
				<div class="alert alert-info">
					{ t.NoStationsFound } { fmt.Sprintf("%.1f km", radius) } { t.OfYourLocation }
				</div>
				if len(suggestions) > 0 {
					<section class="radius-suggestions" aria-labelledby="radius-suggestions-heading">
						<h2 id="radius-suggestions-heading">{ t.ExpandRadiusTitle }</h2>
						<div class="radius-suggestion-list">
							for _, suggestion := range suggestions {
								<a class="radius-suggestion" href={ templ.SafeURL(suggestion.URL) }>
									<strong>{ fmt.Sprintf(t.SearchWithinRadius, suggestion.Radius) }</strong>
									<span class="radius-suggestion-count">
										if suggestion.Count == 1 {
											{ t.OneStation }
										} else {
											{ fmt.Sprintf(t.StationCount, suggestion.Count) }
										}
									</span>
								</a>
							}
						</div>
					</section>
				}
			} else if err != nil {
				<div class="alert alert-error">
					{ t.LocationNotFound }
				</div>
			} else {
				<p class="results-count text-muted">{ t.StationsFound } <strong>{ fmt.Sprintf("%d", len(stations)) }</strong> { t.StationsWithin } { fmt.Sprintf("%.1f km", radius) }</p>
				for _, station := range stations {
					@StationCard(station, t)
				}
			}
		</div>
	}
}

templ StationCard(station api.StationWithDistance, t translations.Translations) {
	<article class="card station-card">
		<div class="card-body">
			<div class="station-heading">
				<h2 class="station-name">{ station.Station.Rotulo }</h2>
				<span class="station-distance" aria-label={ fmt.Sprintf("%.2f %s", station.Distance/1000, t.KmAway) }>{ fmt.Sprintf("%.2f km", station.Distance/1000) }</span>
			</div>
			<p class="station-address text-muted">{ station.Station.Direccion }</p>
			<dl class="station-prices">
				@StationPrice(t.Gasoline95, station.Station.PrecioGasolina95E5, t.NotAvailable)
				@StationPrice(t.Gasoline98, station.Station.PrecioGasolina98E5, t.NotAvailable)
				@StationPrice(t.Diesel, station.Station.PrecioGasoleoA, t.NotAvailable)
				@StationPrice(t.PremiumDiesel, station.Station.PrecioGasoleoPremium, t.NotAvailable)
			</dl>
			<div class="station-map-links">
				<a
					href={ templ.SafeURL(fmt.Sprintf("https://www.openstreetmap.org/?mlat=%s&mlon=%s&zoom=16",
							formatDecimal(station.Station.Latitud),
							formatDecimal(station.Station.Longitud))) }
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-map"
					aria-label={ t.MapAltOSM }
				>
					{ t.MapButton }
				</a>
				<a
					href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%s,%s",
							formatDecimal(station.Station.Latitud),
							formatDecimal(station.Station.Longitud))) }
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-map"
					aria-label={ t.MapAltGoogle }
				>
					{ t.GoogleMapsButton }
				</a>
			</div>
		</div>
	</article>
}

templ StationPrice(label, price, notAvailable string) {
	<div class="station-price">
		<dt>{ strings.TrimSuffix(label, ":") }</dt>
		<dd>{ formatPrice(price, notAvailable) }</dd>
	</div>
}

func formatPrice(value string, notAvailable string) string {
	if value == "" {
		return notAvailable
	}
	return strings.Replace(value, ",", ".", 1) + " €"
}

func formatDecimal(value string) string {
	return strings.Replace(value, ",", ".", 1)
}
