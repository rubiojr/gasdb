package templates

import (
	"fmt"
	"strings"

	"github.com/rubiojr/gasdb/_server/internal/search"
	"github.com/rubiojr/gasdb/_server/translations"
	"github.com/rubiojr/gasdb/pkg/api"
)

templ ResultsPage(stations []api.StationWithDistance, query, resolvedLocation string, lat, lng, radius float64, err error, suggestions []search.RadiusSuggestion, resultsMap ResultsMap, t translations.Translations) {
	@Base(t.ResultsTitle, "", t) {
		<div class="results">
			<div class="results-header">
				<h1>{ t.NearbyStations }</h1>
				if query != "" {
					<p class="results-location"><span class="text-muted">{ t.ResultsFor }</span><strong>{ query }</strong></p>
					if resolvedLocation != "" {
						<p class="results-location resolved-location"><span class="text-muted">{ t.ResolvedLocation }</span><strong>{ resolvedLocation }</strong></p>
					}
				} else {
					<p class="results-location"><span class="text-muted">{ t.ResultsForCoords }</span><strong>{ fmt.Sprintf("%.6f, %.6f", lat, lng) }</strong></p>
				}
				<div class="results-toolbar">
					<p class="results-radius"><span class="text-muted">{ t.RadiusLabel }</span><strong>{ fmt.Sprintf("%.1f km", radius) }</strong></p>
					<div class="results-actions">
						if len(stations) > 0 {
							<button type="button" id="results-map-toggle" class="btn btn-outline-dark" aria-controls="results-map" aria-expanded="false" hidden>{ t.ShowMapButton }</button>
						}
						<a href={ templ.SafeURL("/?lang=" + t.Language) } class="btn btn-outline-dark">{ t.NewSearchButton }</a>
					</div>
				</div>
			</div>
			if len(stations) == 0 && err == nil {
				<div class="alert alert-info">
					{ t.NoStationsFound } { fmt.Sprintf("%.1f km", radius) } { t.OfYourLocation }
				</div>
				if len(suggestions) > 0 {
					<section class="radius-suggestions" aria-labelledby="radius-suggestions-heading">
						<h2 id="radius-suggestions-heading">{ t.ExpandRadiusTitle }</h2>
						<div class="radius-suggestion-list">
							for _, suggestion := range suggestions {
								<a class="radius-suggestion" href={ templ.SafeURL(suggestion.URL) }>
									<strong>{ fmt.Sprintf(t.SearchWithinRadius, suggestion.Radius) }</strong>
									<span class="radius-suggestion-count">
										if suggestion.Count == 1 {
											{ t.OneStation }
										} else {
											{ fmt.Sprintf(t.StationCount, suggestion.Count) }
										}
									</span>
								</a>
							}
						</div>
					</section>
				}
			} else if err != nil {
				<div class="alert alert-error">
					{ t.LocationNotFound }
				</div>
			} else {
				<section
					id="results-map"
					class="results-map"
					aria-label={ t.MapLabel }
					data-stylesheet={ mapLibreStylesheet }
					data-stylesheet-integrity={ mapLibreStylesheetIntegrity }
					hidden
				>
					<div class="map-canvas"></div>
					<p class="map-status" role="status"></p>
				</section>
				<p class="results-count text-muted">{ t.StationsFound } <strong>{ fmt.Sprintf("%d", len(stations)) }</strong> { t.StationsWithin } { fmt.Sprintf("%.1f km", radius) }</p>
				for i, station := range stations {
					@StationCard(station, fmt.Sprintf("station-%d", i), t)
				}
				@resultsMapScript(resultsMap, t)
			}
		</div>
	}
}

templ StationCard(station api.StationWithDistance, id string, t translations.Translations) {
	<article id={ id } class="card station-card">
		<div class="card-body">
			<div class="station-heading">
				<h2 class="station-name">{ station.Station.Rotulo }</h2>
				<span class="station-distance" aria-label={ fmt.Sprintf("%.2f %s", station.Distance/1000, t.KmAway) }>{ fmt.Sprintf("%.2f km", station.Distance/1000) }</span>
			</div>
			<p class="station-address text-muted">{ station.Station.Direccion }</p>
			<dl class="station-prices">
				@StationPrice(t.Gasoline95, station.Station.PrecioGasolina95E5, t.NotAvailable)
				@StationPrice(t.Gasoline98, station.Station.PrecioGasolina98E5, t.NotAvailable)
				@StationPrice(t.Diesel, station.Station.PrecioGasoleoA, t.NotAvailable)
				@StationPrice(t.PremiumDiesel, station.Station.PrecioGasoleoPremium, t.NotAvailable)
			</dl>
			@StationLinks(station.Station, t) {
				if station.Station.IDEESS != "" {
					<a href={ stationURL(station.Station, t) } class="btn btn-map" aria-label={ t.StationPageAlt }>
						{ t.StationPageButton }
					</a>
				}
			}
		</div>
	</article>
}

// StationLinks are a station's map links, followed by its children.
templ StationLinks(station *api.GasStation, t translations.Translations) {
	<div class="station-map-links">
		<a
			href={ templ.SafeURL(fmt.Sprintf("https://www.openstreetmap.org/?mlat=%s&mlon=%s&zoom=16",
					formatDecimal(station.Latitud),
					formatDecimal(station.Longitud))) }
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-map"
			aria-label={ t.MapAltOSM }
		>
			{ t.MapButton }
		</a>
		<a
			href={ templ.SafeURL(fmt.Sprintf("https://www.google.com/maps?q=%s,%s",
					formatDecimal(station.Latitud),
					formatDecimal(station.Longitud))) }
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-map"
			aria-label={ t.MapAltGoogle }
		>
			{ t.GoogleMapsButton }
		</a>
		{ children... }
	</div>
}

// resultsMapScript wires the map toggle. MapLibre and the map styles load on
// the first click only, so pages that never show the map stay light.
templ resultsMapScript(resultsMap ResultsMap, t translations.Translations) {
	@templ.JSONScript("results-map-data", resultsMap)
	@mapAssets(t)
	<script type="module">
		// Popups open above the price pill rather than over it.
		const POPUP_OFFSET = { 'bottom': [0, -32], 'bottom-left': [0, -32], 'bottom-right': [0, -32] };

		const data = JSON.parse(document.getElementById('results-map-data').textContent);
		const text = JSON.parse(document.getElementById('map-text').textContent);
		const toggle = document.getElementById('results-map-toggle');
		const panel = document.getElementById('results-map');
		const container = panel.querySelector('.map-canvas');
		const status = panel.querySelector('.map-status');
		let loading = null;

		toggle.addEventListener('click', function() {
			const open = panel.hidden;
			setOpen(open);
			// The URL keeps the map's state, so shared links show it too.
			const url = new URL(location.href);
			if (open) {
				url.searchParams.set('map', '1');
			} else {
				url.searchParams.delete('map');
			}
			history.replaceState(history.state, '', url);
		});
		toggle.hidden = false;
		if (new URLSearchParams(location.search).get('map') === '1') setOpen(true);

		function setOpen(open) {
			panel.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
			toggle.textContent = open ? text.hide : text.show;
			if (open && !loading) {
				loading = showMap().catch(function(error) {
					console.error(error);
					status.textContent = text.unavailable;
					loading = null; // Try again on the next click.
				});
			}
		}

		function loadStylesheet() {
			return new Promise(function(resolve, reject) {
				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = panel.dataset.stylesheet;
				link.integrity = panel.dataset.stylesheetIntegrity;
				link.crossOrigin = 'anonymous';
				link.onload = resolve;
				link.onerror = function() {
					link.remove();
					reject(new Error('Failed to load ' + link.href));
				};
				document.head.append(link);
			});
		}

		async function showMap() {
			status.textContent = text.loading;
			const [maplibregl] = await Promise.all([import('maplibre-gl'), loadStylesheet()]);
			const bounds = new maplibregl.LngLatBounds(data.center, data.center);
			data.stations.forEach(function(station) { bounds.extend([station.lng, station.lat]); });
			const map = new maplibregl.Map({
				container: container,
				style: data.style,
				bounds: bounds,
				fitBoundsOptions: { padding: 48, maxZoom: 15 },
				cooperativeGestures: true,
				attributionControl: { compact: true },
				locale: text.locale,
			});
			map.addControl(new maplibregl.NavigationControl({ showCompass: false }));
			let loaded = false;
			map.once('load', function() {
				loaded = true;
				status.textContent = '';
				addRadius(map);
			});
			map.on('error', function(event) {
				console.error(event.error);
				if (!loaded) status.textContent = text.unavailable;
			});
			addMarkers(maplibregl, map);
		}

		function addRadius(map) {
			// The container's accent-color resolves --green, which MapLibre can't
			// read as a CSS variable.
			const color = getComputedStyle(container).accentColor;
			map.addSource('search-radius', { type: 'geojson', data: circle(data.center, data.radius_km) });
			map.addLayer({ id: 'search-radius-fill', type: 'fill', source: 'search-radius', paint: { 'fill-color': color, 'fill-opacity': 0.06 } });
			map.addLayer({ id: 'search-radius-line', type: 'line', source: 'search-radius', paint: { 'line-color': color, 'line-width': 1.5, 'line-dasharray': [3, 2] } });
		}

		function addMarkers(maplibregl, map) {
			const center = document.createElement('div');
			center.className = 'map-center';
			center.setAttribute('role', 'img');
			center.setAttribute('aria-label', text.search_center);
			center.title = text.search_center;
			new maplibregl.Marker({ element: center }).setLngLat(data.center).addTo(map);

			const prices = data.stations.filter(function(station) { return station.price !== null; }).map(function(station) { return station.price; });
			const lowest = Math.min.apply(null, prices);
			// Stations come cheapest first; adding them in reverse keeps the cheapest on top.
			for (let i = data.stations.length - 1; i >= 0; i--) {
				const station = data.stations[i];
				const price = station.price === null ? text.not_available : station.price.toFixed(3) + ' €';
				const marker = document.createElement('div');
				marker.className = 'map-marker';
				marker.classList.toggle('map-marker-lowest', station.price === lowest);
				marker.classList.toggle('map-marker-unpriced', station.price === null);
				marker.setAttribute('role', 'button');
				marker.setAttribute('aria-label', station.name + ': ' + price);
				marker.textContent = price;
				const popup = new maplibregl.Popup({ offset: POPUP_OFFSET, maxWidth: 'min(20rem, calc(100% - 1.5rem))' }).setDOMContent(popupContent(i));
				popup.on('open', function() {
					// Focusing the popup scrolls the clipped map container to show it.
					// Undo that, and when the popup doesn't fit, pan its marker near the
					// bottom of the map, leaving room above for the popup.
					container.scrollTop = 0;
					container.scrollLeft = 0;
					const box = popup.getElement().getBoundingClientRect();
					const frame = container.getBoundingClientRect();
					if (box.top >= frame.top && box.bottom <= frame.bottom && box.left >= frame.left && box.right <= frame.right) return;
					map.panTo([station.lng, station.lat], { offset: [0, frame.height / 2 - 56] });
				});
				new maplibregl.Marker({ element: marker, anchor: 'bottom', offset: [0, -6] })
					.setLngLat([station.lng, station.lat])
					.setPopup(popup)
					.addTo(map);
			}
		}

		// The popup reuses the station's result card.
		function popupContent(index) {
			const body = document.getElementById('station-' + index).querySelector('.card-body').cloneNode(true);
			body.className = 'map-popup';
			return body;
		}

		// circle approximates the search radius as a GeoJSON polygon.
		function circle(center, km) {
			const steps = 96;
			const latDegrees = km / 110.574;
			const lngDegrees = km / (111.32 * Math.cos(center[1] * Math.PI / 180));
			const ring = [];
			for (let i = 0; i <= steps; i++) {
				const angle = i / steps * 2 * Math.PI;
				ring.push([center[0] + lngDegrees * Math.cos(angle), center[1] + latDegrees * Math.sin(angle)]);
			}
			return { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [ring] } };
		}
	</script>
}

templ StationPrice(label, price, notAvailable string) {
	<div class="station-price">
		<dt>{ strings.TrimSuffix(label, ":") }</dt>
		<dd>{ formatPrice(price, notAvailable) }</dd>
	</div>
}

func formatPrice(value string, notAvailable string) string {
	if value == "" {
		return notAvailable
	}
	return strings.Replace(value, ",", ".", 1) + " €"
}

func formatDecimal(value string) string {
	return strings.Replace(value, ",", ".", 1)
}
